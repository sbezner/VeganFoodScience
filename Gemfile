source "https://rubygems.org"

# Pinned to the github-pages gem so this site can be built and served by
# GitHub Pages exactly as it is on github.io.
gem "github-pages", group: :jekyll_plugins

# Standard Jekyll plugin set used by GitHub Pages
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby support
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
